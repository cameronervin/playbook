# Normalize line endings to LF for all text files
* text=auto eol=lf

# Explicitly LF for source files
*.py        text eol=lf
*.ts        text eol=lf
*.tsx       text eol=lf
*.js        text eol=lf
*.cjs       text eol=lf
*.css       text eol=lf
*.html      text eol=lf
*.json      text eol=lf
*.toml      text eol=lf
*.yml       text eol=lf
*.yaml      text eol=lf
*.md        text eol=lf
*.mdc       text eol=lf
*.txt       text eol=lf
*.ini       text eol=lf
*.conf      text eol=lf
*.properties text eol=lf
*.sh        text eol=lf
*.ps1       text eol=lf
*.mako      text eol=lf

# Binary files - no line ending conversion
*.png       binary
*.jpg       binary
*.jpeg      binary
*.gif       binary
*.ico       binary
*.woff      binary
*.woff2     binary
*.ttf       binary
*.eot       binary
