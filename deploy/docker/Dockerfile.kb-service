# KB Service image — FastAPI RAG service (docling → OpenAI embeddings → pgvector).
# Single-stage: docling pulls large ML wheels, so a wheel-cache multistage saves
# little here. libpq-dev is needed for psycopg2 (the sync driver used by Alembic
# and the Celery workers' vector inserts).
FROM python:3.12-slim

# System deps: curl for the healthcheck, libpq for the Postgres client.
RUN apt-get update && apt-get install -y --no-install-recommends \
    curl \
    libpq-dev \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

# Application code and migrations.
COPY app app/
COPY alembic alembic/
COPY alembic.ini .

EXPOSE 8001

HEALTHCHECK --interval=30s --timeout=10s --start-period=20s --retries=3 \
    CMD curl -f http://localhost:8001/health || exit 1

CMD ["uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8001"]
