# Backend API + backend Celery Sentry runtime overlay.
# Copy to `.env.backend.prod`, fill from a secrets manager, and do NOT commit.

SENTRY_ENABLED=false
SENTRY_DSN=${BACKEND_SENTRY_DSN}        # secrets manager; backend project DSN
SENTRY_ENVIRONMENT=production
SENTRY_RELEASE=
SENTRY_TRACES_SAMPLE_RATE=0.1
SENTRY_PROFILES_SAMPLE_RATE=0.0
