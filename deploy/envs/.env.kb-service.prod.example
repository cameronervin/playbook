# KB-service API + KB Celery Sentry runtime overlay.
# Copy to `.env.kb-service.prod`, fill from a secrets manager, and do NOT commit.

SENTRY_ENABLED=false
SENTRY_DSN=${KB_SERVICE_SENTRY_DSN}     # secrets manager; kb-service project DSN
SENTRY_ENVIRONMENT=production
SENTRY_RELEASE=
SENTRY_TRACES_SAMPLE_RATE=0.1
SENTRY_PROFILES_SAMPLE_RATE=0.0
