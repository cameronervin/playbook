# LiteLLM local Docker Compose defaults. Copy to `.env.litellm.local` and edit.
# This file is consumed only by the LiteLLM proxy container.

# --- LiteLLM Proxy ---
LITELLM_MASTER_KEY=sk-local-litellm-master-key
LITELLM_SALT_KEY=sk-local-litellm-salt-key-change-me
LITELLM_DATABASE_URL=postgresql://app:localpass@db:5432/litellm
LITELLM_IMAGE_TAG=1.84.1
LITELLM_PLAYBOOK_CHAT_MODEL=openai/gpt-5.4
LITELLM_PLAYBOOK_FAST_MODEL=openai/gpt-5.4-mini
LITELLM_PLAYBOOK_EMBED_MODEL=openai/text-embedding-3-small
LITELLM_PLAYBOOK_OCR_MODEL=openai/gpt-5.4-mini
LITELLM_PLAYBOOK_RERANK_MODEL=infinity/rerank

# --- Provider API keys owned by LiteLLM ---
ANTHROPIC_API_KEY=replace-with-your-anthropic-api-key
OPENAI_API_KEY=replace-with-your-openai-api-key
OPENAI_API_BASE=https://us.api.openai.com/v1

# --- Self-hosted Infinity reranker owned by LiteLLM ---
INFINITY_API_BASE=http://reranker:7997
INFINITY_API_KEY=local-infinity-reranker-key
