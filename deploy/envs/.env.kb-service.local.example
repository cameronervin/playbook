# KB Service local Docker Compose defaults. Copy to `.env.kb-service.local` and edit as needed.
# Values are local-development placeholders only.

# --- Service ---
PROJECT_NAME=KB Service
ENVIRONMENT=local
LOG_LEVEL=DEBUG

# --- Database (shared Postgres; kb-service manages the "kb" schema) ---
DATABASE_URL=postgresql+asyncpg://app:localpass@db:5432/playbook

# --- Celery / Valkey (dedicated kb-valkey instance) ---
CELERY_BROKER_URL=redis://kb-valkey:6379/0
CELERY_RESULT_BACKEND=redis://kb-valkey:6379/1

# --- Embeddings ---
KB_LLM_PROVIDER_MODE=direct
KB_EMBED_DIMENSIONS=1536
OPENAI_API_KEY=replace-with-your-openai-api-key
OPENAI_EMBED_MODEL=text-embedding-3-small
LLM_GATEWAY_BASE_URL=http://litellm:4000
LLM_GATEWAY_API_KEY=local-gateway-key
LLM_GATEWAY_EMBED_MODEL=text-embedding-3-small

# --- Storage (MinIO S3-compatible storage: originals + staged NDJSON) ---
AWS_S3_BUCKET=kb-documents
AWS_S3_ENDPOINT_URL=http://minio:9000
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=playbookminio
AWS_SECRET_ACCESS_KEY=playbookminio123

# --- Service-to-service auth (caller -> KB API) ---
KB_API_SECRET=local-kb-shared-secret

# --- Webhook (KB -> backend status push, HMAC-SHA256 signed) ---
APP_WEBHOOK_URL=http://backend:8000
KB_WEBHOOK_SECRET=local-kb-webhook-secret

# --- Parsing ---
OCR_PROVIDER=none
ENABLE_DOCLING_ROUTING=true
DOCLING_ENABLED=true

# --- Chunking / search defaults ---
KB_CHUNK_SIZE_TOKENS=400
KB_CHUNK_OVERLAP_TOKENS=40
KB_SEARCH_MAX_DOCS=10
KB_SEARCH_SCORE_THRESHOLD=0.7
