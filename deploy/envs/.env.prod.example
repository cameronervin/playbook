# Production environment TEMPLATE.
# Copy to .env.prod and populate real values — but do NOT commit .env.prod.
#
# Recommended: do not store real secrets in a file at all. Inject them from a
# secrets manager (AWS Secrets Manager, HashiCorp Vault, SSM Parameter Store)
# at deploy time. The ${PLACEHOLDER} values below indicate secrets-manager keys.

# --- App ---
ENVIRONMENT=prod
DEBUG=false
LOG_LEVEL=WARNING
CELERY_WORKER_LOG_LEVEL=INFO

# --- Database (internal network only — do not expose the port) ---
DB_USER=${DB_USER}
DB_PASSWORD=${DB_PASSWORD}            # secrets manager
DB_NAME=${DB_NAME}
DATABASE_URL=postgresql+asyncpg://${DB_USER}:${DB_PASSWORD}@db:5432/${DB_NAME}

# --- Auth ---
SECRET_KEY=${SECRET_KEY}              # secrets manager — long random value
OAUTH_STATE_SECRET=${OAUTH_STATE_SECRET}  # secrets manager — long random value
# Explicit allowed origins — never "*" in production.
CORS_ORIGINS=https://app.example.com
FRONTEND_URL=https://app.example.com
API_PUBLIC_URL=https://app.example.com
COOKIE_DOMAIN=.example.com
DEV_AUTH_ENABLED=false

# --- LLM ---
# Use LiteLLM mode in production. Direct mode is only for local smoke
# tests or an explicit break-glass path.
LLM_PROVIDER_MODE=litellm
ALLOW_DIRECT_LLM_IN_PROD=false
LLM_CHAT_MODEL=playbook-chat
LITELLM_BASE_URL=http://litellm:4000
LITELLM_API_KEY=${LITELLM_API_KEY}    # LiteLLM virtual/service key

# --- KB Service ---
KB_PROVIDER_MODE=local
KB_LOCAL_BASE_URL=http://kb-api:8001
KB_API_SECRET=${KB_API_SECRET}                # secrets manager
KB_WEBHOOK_SECRET=${KB_WEBHOOK_SECRET}        # secrets manager
KB_EMBED_DIMENSIONS=1536
LITELLM_EMBED_MODEL=playbook-embed
LITELLM_SUMMARY_MODEL=playbook-fast
LITELLM_RERANK_MODEL=playbook-rerank
KB_SUMMARY_INPUT_MAX_TOKENS=3000
KB_SUMMARY_MAX_OUTPUT_TOKENS=160
KB_RERANK_ENABLED=false
KB_RERANK_CANDIDATE_LIMIT=50
KB_RERANK_TIMEOUT_SECONDS=10.0
KB_RERANK_FAIL_OPEN=true

# --- LiteLLM Proxy ---
# These are consumed by the LiteLLM proxy deployment, not by app runtimes.
# Provider API keys and provider model IDs must be injected only into the
# LiteLLM deployment/secrets, not into backend or KB-service env.
LITELLM_IMAGE_TAG=1.84.1
LITELLM_MASTER_KEY=${LITELLM_MASTER_KEY}      # secrets manager
LITELLM_SALT_KEY=${LITELLM_SALT_KEY}          # secrets manager; do not rotate after storing provider keys
LITELLM_DATABASE_URL=${LITELLM_DATABASE_URL}  # separate LiteLLM DB/user preferred
LITELLM_PLAYBOOK_RERANK_MODEL=infinity/rerank
INFINITY_API_BASE=http://reranker:7997
INFINITY_API_KEY=${INFINITY_API_KEY}          # secrets manager; shared by LiteLLM and reranker service

# --- Storage (real S3 — prefer an instance role over static keys) ---
S3_BUCKET_NAME=${S3_BUCKET_NAME}
S3_PUBLIC_ENDPOINT_URL=${S3_PUBLIC_ENDPOINT_URL}  # optional; only needed behind a browser-facing S3 proxy
S3_ACCESS_KEY_ID=${S3_ACCESS_KEY_ID}          # secrets manager (or omit if using IAM role)
S3_SECRET_ACCESS_KEY=${S3_SECRET_ACCESS_KEY}  # secrets manager (or omit if using IAM role)
S3_REGION=${S3_REGION}
CONVERSATION_FILE_MAX_UPLOAD_MB=200

# --- Async ---
CELERY_BROKER_URL=redis://valkey:6379/0
CELERY_RESULT_BACKEND=redis://valkey:6379/1
AGENT_STREAM_VALKEY_URL=redis://valkey:6379/2

# --- Rate limiting ---
# Application-level fallback limits complement edge/WAF controls and LiteLLM
# virtual-key budgets. Keep the store on Valkey in production so all API
# replicas share the same sliding-window counters.
RATE_LIMIT_ENABLED=true
RATE_LIMIT_STORE_MODE=valkey
RATE_LIMIT_VALKEY_URL=redis://valkey:6379/3
RATE_LIMIT_AUTH_MAX_REQUESTS=20
RATE_LIMIT_AUTH_WINDOW_SECONDS=60
RATE_LIMIT_ATHLETE_CHAT_MAX_REQUESTS=30
RATE_LIMIT_ATHLETE_CHAT_WINDOW_SECONDS=60
RATE_LIMIT_ADMIN_CHAT_MAX_REQUESTS=30
RATE_LIMIT_ADMIN_CHAT_WINDOW_SECONDS=60
RATE_LIMIT_INSIGHT_RUN_MAX_REQUESTS=10
RATE_LIMIT_INSIGHT_RUN_WINDOW_SECONDS=300
RATE_LIMIT_UPLOAD_MAX_REQUESTS=20
RATE_LIMIT_UPLOAD_WINDOW_SECONDS=60
RATE_LIMIT_LIST_MAX_REQUESTS=120
RATE_LIMIT_LIST_WINDOW_SECONDS=60

# --- Runtime tracing (backend API + backend Celery workers only) ---
TRACING_ENABLED=false
LANGFUSE_ENABLED=false
LANGFUSE_PUBLIC_KEY=${LANGFUSE_PUBLIC_KEY}
LANGFUSE_SECRET_KEY=${LANGFUSE_SECRET_KEY}  # secrets manager
LANGFUSE_BASE_URL=https://cloud.langfuse.com

# --- Sentry monitoring ---
# Use hosted Sentry projects named frontend, backend, and kb-service.
# Backend API/workers and KB API/workers read SENTRY_* at runtime. Because this
# shared file is loaded by both services, keep service-specific DSNs in optional
# overlays:
#   cp deploy/envs/.env.backend.prod.example deploy/envs/.env.backend.prod
#   cp deploy/envs/.env.kb-service.prod.example deploy/envs/.env.kb-service.prod
# SENTRY_AUTH_TOKEN is build/CI-only for frontend source-map upload; do not put
# it in runtime env files or committed templates.
SENTRY_ENABLED=false
SENTRY_ENVIRONMENT=production
SENTRY_RELEASE=
SENTRY_TRACES_SAMPLE_RATE=0.1
SENTRY_PROFILES_SAMPLE_RATE=0.0

# --- Frontend ---
NEXT_PUBLIC_API_URL=https://app.example.com
NEXT_PUBLIC_SENTRY_DSN=${FRONTEND_SENTRY_DSN}
NEXT_PUBLIC_SENTRY_ENVIRONMENT=production
NEXT_PUBLIC_SENTRY_RELEASE=
NEXT_PUBLIC_SENTRY_TRACES_SAMPLE_RATE=0.1
