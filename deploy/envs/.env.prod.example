# Production environment TEMPLATE.
# Copy to .env.prod and populate real values — but do NOT commit .env.prod.
#
# Recommended: do not store real secrets in a file at all. Inject them from a
# secrets manager (AWS Secrets Manager, HashiCorp Vault, SSM Parameter Store)
# at deploy time. The ${PLACEHOLDER} values below indicate secrets-manager keys.

# --- App ---
ENVIRONMENT=prod
DEBUG=false
LOG_LEVEL=WARNING

# --- Database (internal network only — do not expose the port) ---
DB_USER=${DB_USER}
DB_PASSWORD=${DB_PASSWORD}            # secrets manager
DB_NAME=${DB_NAME}
DATABASE_URL=postgresql+asyncpg://${DB_USER}:${DB_PASSWORD}@db:5432/${DB_NAME}

# --- Auth ---
SECRET_KEY=${SECRET_KEY}              # secrets manager — long random value
# Explicit allowed origins — never "*" in production.
CORS_ORIGINS=https://app.example.com

# --- LLM ---
# Use LiteLLM mode in production. Direct mode is only for local smoke
# tests or an explicit break-glass path.
LLM_PROVIDER_MODE=litellm
LLM_CHAT_MODEL=playbook-chat
LLM_DIRECT_PROVIDER=anthropic
LITELLM_BASE_URL=${LITELLM_BASE_URL}  # e.g. http://litellm:4000
LITELLM_API_KEY=${LITELLM_API_KEY}    # LiteLLM virtual/service key
# Direct mode only:
ANTHROPIC_API_KEY=${ANTHROPIC_API_KEY}        # secrets manager

# --- LiteLLM Proxy ---
# These are consumed by the LiteLLM proxy deployment, not by the app runtime.
LITELLM_MASTER_KEY=${LITELLM_MASTER_KEY}      # secrets manager
LITELLM_SALT_KEY=${LITELLM_SALT_KEY}          # secrets manager; do not rotate after storing provider keys
LITELLM_DATABASE_URL=${LITELLM_DATABASE_URL}  # separate LiteLLM DB/user preferred

# --- Storage (real S3 — prefer an instance role over static keys) ---
S3_BUCKET_NAME=${S3_BUCKET_NAME}
S3_ACCESS_KEY_ID=${S3_ACCESS_KEY_ID}          # secrets manager (or omit if using IAM role)
S3_SECRET_ACCESS_KEY=${S3_SECRET_ACCESS_KEY}  # secrets manager (or omit if using IAM role)
S3_REGION=${S3_REGION}

# --- Async ---
CELERY_BROKER_URL=redis://valkey:6379/0
CELERY_RESULT_BACKEND=redis://valkey:6379/1

# --- Frontend ---
NEXT_PUBLIC_API_URL=https://app.example.com
