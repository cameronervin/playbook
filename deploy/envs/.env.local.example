# Local Docker Compose defaults. Copy to `.env.local` and edit as needed.

ENVIRONMENT=local
DEBUG=true
LOG_LEVEL=DEBUG

DB_PASSWORD=localpass
DATABASE_URL=postgresql+asyncpg://app:localpass@db:5432/playbook

SECRET_KEY=change-me-in-production
FRONTEND_URL=http://localhost:3000
CORS_ORIGINS=["http://localhost:3000"]
DEV_AUTH_ENABLED=false

LLM_PROVIDER_MODE=litellm
LLM_CHAT_MODEL=playbook-chat
LLM_DIRECT_PROVIDER=anthropic
# Docker Compose services call LiteLLM over the internal network. If running the
# backend directly on the host, override this to http://localhost:4000.
LITELLM_BASE_URL=http://litellm:4000
# First local boot can use LITELLM_MASTER_KEY from .env.litellm.local; replace
# with a scoped virtual/service key after generating one in LiteLLM.
LITELLM_API_KEY=sk-local-litellm-master-key

# Local S3-compatible object storage (MinIO)
MINIO_ROOT_USER=playbookminio
MINIO_ROOT_PASSWORD=playbookminio123
S3_ENDPOINT_URL=http://minio:9000
S3_BUCKET_NAME=playbook-bucket
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=playbookminio
S3_SECRET_ACCESS_KEY=playbookminio123

# Backend Celery + agent streaming use the shared app Valkey instance.
CELERY_BROKER_URL=redis://valkey:6379/0
CELERY_RESULT_BACKEND=redis://valkey:6379/1
AGENT_STREAM_VALKEY_URL=redis://valkey:6379/2
