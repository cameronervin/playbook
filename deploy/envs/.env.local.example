# Local Docker Compose defaults. Copy to `.env.local` and edit as needed.

ENVIRONMENT=local
DEBUG=true
LOG_LEVEL=DEBUG
CELERY_WORKER_LOG_LEVEL=INFO

DB_PASSWORD=localpass
DATABASE_URL=postgresql+asyncpg://app:localpass@db:5432/playbook
DB_UI_PORT=5050
DB_UI_ADMIN_PASSWORD=playbook-local-db-ui
DB_UI_CUSTOM_CONNECTIONS_ENABLED=true

SECRET_KEY=change-me-in-production
FRONTEND_URL=http://localhost:3000
CORS_ORIGINS=["http://localhost:3000"]
DEV_AUTH_ENABLED=false

LLM_PROVIDER_MODE=litellm
LLM_CHAT_MODEL=playbook-chat
# Docker Compose services call LiteLLM over the internal network. If running the
# backend directly on the host, override this to http://localhost:4000.
LITELLM_BASE_URL=http://litellm:4000
# First local boot can use LITELLM_MASTER_KEY from .env.litellm.local; replace
# with a scoped virtual/service key after generating one in LiteLLM.
LITELLM_API_KEY=sk-local-litellm-master-key
# Optional eval-only LiteLLM key. Leave blank to fall back to LITELLM_API_KEY;
# prefer a scoped key with playbook-chat, playbook-fast, and playbook-embed.
EVAL_LITELLM_API_KEY=
EVAL_EMBEDDINGS_MODEL=playbook-embed
RAGAS_DO_NOT_TRACK=true

# Local S3-compatible object storage (MinIO)
MINIO_ROOT_USER=playbookminio
MINIO_ROOT_PASSWORD=playbookminio123
S3_ENDPOINT_URL=http://minio:9000
S3_PUBLIC_ENDPOINT_URL=http://localhost:9000
S3_BUCKET_NAME=playbook-bucket
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=playbookminio
S3_SECRET_ACCESS_KEY=playbookminio123
CONVERSATION_FILE_MAX_UPLOAD_MB=200

# Backend Celery + agent streaming use the shared app Valkey instance.
CELERY_BROKER_URL=redis://valkey:6379/0
CELERY_RESULT_BACKEND=redis://valkey:6379/1
AGENT_STREAM_VALKEY_URL=redis://valkey:6379/2

# Optional application-level rate limiting. Keep disabled locally unless you are
# smoke-testing abuse-prevention behavior; production enables the shared Valkey
# store in `.env.prod.example`.
RATE_LIMIT_ENABLED=false
RATE_LIMIT_STORE_MODE=memory
RATE_LIMIT_VALKEY_URL=redis://valkey:6379/3
RATE_LIMIT_AUTH_MAX_REQUESTS=20
RATE_LIMIT_AUTH_WINDOW_SECONDS=60
RATE_LIMIT_ATHLETE_CHAT_MAX_REQUESTS=30
RATE_LIMIT_ATHLETE_CHAT_WINDOW_SECONDS=60
RATE_LIMIT_ADMIN_CHAT_MAX_REQUESTS=30
RATE_LIMIT_ADMIN_CHAT_WINDOW_SECONDS=60
RATE_LIMIT_INSIGHT_RUN_MAX_REQUESTS=10
RATE_LIMIT_INSIGHT_RUN_WINDOW_SECONDS=300
RATE_LIMIT_UPLOAD_MAX_REQUESTS=20
RATE_LIMIT_UPLOAD_WINDOW_SECONDS=60
RATE_LIMIT_LIST_MAX_REQUESTS=120
RATE_LIMIT_LIST_WINDOW_SECONDS=60

# Optional runtime Langfuse tracing for backend API and backend Celery workers.
# Keep disabled unless you are using an approved local/dev Langfuse project.
TRACING_ENABLED=false
LANGFUSE_ENABLED=false
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=https://cloud.langfuse.com

# Optional runtime Sentry monitoring. Keep disabled locally unless you are
# validating an approved dev Sentry project.
SENTRY_ENABLED=false
SENTRY_DSN=
SENTRY_ENVIRONMENT=local
SENTRY_RELEASE=
SENTRY_TRACES_SAMPLE_RATE=0.1
SENTRY_PROFILES_SAMPLE_RATE=0.0

# Frontend public Sentry config. NEXT_PUBLIC_SENTRY_DSN is public by design;
# SENTRY_AUTH_TOKEN is build/CI-only and must never be committed here.
NEXT_PUBLIC_SENTRY_DSN=
NEXT_PUBLIC_SENTRY_ENVIRONMENT=local
NEXT_PUBLIC_SENTRY_RELEASE=
NEXT_PUBLIC_SENTRY_TRACES_SAMPLE_RATE=0.1
