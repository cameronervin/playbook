# Infinity reranker defaults. Copy to `.env.reranker.local`, `.env.reranker.dev`,
# or `.env.reranker.prod` when enabling the optional reranker profile.
#
# Keep this file scoped to Infinity runtime settings. Provider keys and LiteLLM
# master/salt keys belong in the LiteLLM env, not in the reranker service.
# INFINITY_API_KEY must match the LiteLLM env value for INFINITY_API_KEY.

INFINITY_API_KEY=local-infinity-reranker-key
DO_NOT_TRACK=1
INFINITY_ANONYMOUS_USAGE_STATS=0
