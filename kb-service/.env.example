# KB Service — environment variables reference.
# Copy this file to .env and fill in the required values. Do NOT commit .env.
#
# Required (no defaults — must be set): DATABASE_URL, KB_WEBHOOK_SECRET, KB_API_SECRET.
# For the embed stage in LiteLLM mode, LITELLM_BASE_URL and LITELLM_API_KEY
# are also required.
# Everything else has a working local-development default.

# --- Service ---
PROJECT_NAME=KB Service
ENVIRONMENT=local                            # local | dev | test | prod
LOG_LEVEL=DEBUG                              # DEBUG | INFO | WARNING | ERROR | CRITICAL

# --- Sentry monitoring ---
# Disabled unless SENTRY_ENABLED=true and SENTRY_DSN is set. Use the kb-service
# Sentry project DSN for both KB API and KB workers.
SENTRY_ENABLED=false
SENTRY_DSN=
SENTRY_ENVIRONMENT=local
SENTRY_RELEASE=
SENTRY_TRACES_SAMPLE_RATE=0.1
SENTRY_PROFILES_SAMPLE_RATE=0.0

# --- Database (required — no default) ---
# Async driver. Models live in the dedicated `kb` schema so this can share a
# Postgres instance with the host app while staying isolated.
# Run: alembic upgrade head   (after the kb schema role/db exist)
DATABASE_URL=postgresql+asyncpg://kb:kb@localhost:5432/kb

# --- Celery / Valkey (task queue) ---
CELERY_BROKER_URL=redis://kb-valkey:6379/0
CELERY_RESULT_BACKEND=redis://kb-valkey:6379/1

# --- Embedding provider ---
# Choose the embedding backend:
#   litellm → routes through a managed LiteLLM proxy (default)
#   direct  → calls OpenAI directly only when explicitly configured outside normal app envs
LLM_PROVIDER_MODE=litellm

# litellm mode (active when LLM_PROVIDER_MODE=litellm):
LITELLM_BASE_URL=http://litellm:4000
LITELLM_API_KEY=                             # LiteLLM virtual/service key
LITELLM_EMBED_MODEL=playbook-embed           # LiteLLM model alias; provider model IDs live in LiteLLM env
LITELLM_VLM_MODEL=playbook-ocr               # LiteLLM vision model alias for opt-in scanned PDF OCR
LITELLM_SUMMARY_MODEL=playbook-fast          # LiteLLM text alias for source summaries
LITELLM_RERANK_MODEL=playbook-rerank         # LiteLLM rerank alias used by internal reranker provider

# source summary generation:
KB_SUMMARY_INPUT_MAX_TOKENS=3000             # max extracted/source tokens sent to summary model
KB_SUMMARY_MAX_OUTPUT_TOKENS=160             # max generated summary tokens

# embedding tuning (applies to both modes):
KB_EMBED_DIMENSIONS=1536                     # must match the LiteLLM alias output
KB_EMBED_BATCH_SIZE=50                       # chunks per embed_batch_task call
KB_EMBED_MAX_BATCH_CHARS=60000               # max characters per batch (token-limit guard)
KB_EMBED_MAX_CONCURRENT_BATCHES=4            # parallel embed batches per document
KB_EMBED_REQUEST_TIMEOUT_SECONDS=60.0        # per-request HTTP timeout
KB_EMBED_MAX_RETRIES=5                       # retries on 429 / transient 5xx
KB_EMBED_BACKOFF_BASE_SECONDS=2              # exponential backoff base: 2s→4s→8s→16s→32s
KB_EMBED_BACKOFF_MAX_SECONDS=120             # backoff ceiling
KB_EMBED_RETRY_JITTER=true                   # randomise backoff to avoid thundering herd

# --- S3-compatible storage / MinIO (document storage + NDJSON staging) ---
S3_BUCKET_NAME=playbook-bucket               # bucket for uploads + staged NDJSON
S3_ENDPOINT_URL=http://minio:9000            # local only — omit for real AWS
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=playbookminio               # local MinIO user
S3_SECRET_ACCESS_KEY=playbookminio123        # local MinIO password
# AWS_PROFILE=                               # named profile; used when keys are unset
S3_STREAM_MAX_FILE_SIZE_MB=512               # reject objects larger than this before download
S3_STREAM_SPOOL_MAX_SIZE_MB=32               # in-memory staging buffer; spills to disk beyond this
KB_MAX_DOCUMENT_SIZE_MB=200                  # ingest size guard (HEAD-checked before download)

# --- Webhook (required — KB Service → calling app status push, HMAC-SHA256 signed) ---
# Posts to {APP_WEBHOOK_URL}/api/v1/kb/webhook with X-KB-Signature header.
# Generate a strong secret: openssl rand -hex 32
APP_WEBHOOK_URL=http://localhost:8000        # base URL of the calling app (no trailing slash)
KB_WEBHOOK_SECRET=                           # REQUIRED — HMAC-SHA256 shared secret
KB_WEBHOOK_MAX_RETRIES=5
KB_WEBHOOK_BACKOFF_BASE=2                    # seconds; doubles each attempt: 2→4→8…

# --- Service-to-service auth (required — caller → KB API) ---
# All /api/kb/* endpoints require: Authorization: Bearer <KB_API_SECRET>
# Generate a strong secret: openssl rand -hex 32
KB_API_SECRET=                               # REQUIRED — Bearer token

# --- Chunking (changing these after ingestion requires re-ingesting all documents) ---
KB_CHUNK_SIZE_TOKENS=400                     # target chunk size (~300 words)
KB_CHUNK_OVERLAP_TOKENS=40                   # overlap between adjacent chunks
KB_CHUNK_TOKENIZER=cl100k_base               # tiktoken encoder

# --- Search ---
KB_SEARCH_MAX_DOCS=10                        # max chunks returned per query
KB_SEARCH_SCORE_THRESHOLD=0.7                # min cosine similarity to include a chunk (0.0–1.0)
KB_SEARCH_STRATEGY=semantic                  # semantic | hybrid; hybrid is internal/server-configured only
KB_HYBRID_CANDIDATE_LIMIT=50                 # semantic + lexical candidates merged before final limit
KB_RRF_K=60                                  # reciprocal-rank fusion constant for hybrid candidate ranking
KB_RERANK_ENABLED=false                      # enable cross-encoder reranking when KB_SEARCH_STRATEGY=hybrid
KB_RERANK_CANDIDATE_LIMIT=50                 # max hybrid candidates sent to LiteLLM /rerank
KB_RERANK_TIMEOUT_SECONDS=10.0               # rerank request timeout
KB_RERANK_FAIL_OPEN=true                     # fallback to hybrid-ranked results on rerank failure

# --- Worker / vectorstore ---
KB_VECTORSTORE_POOL_SIZE=5                   # SQLAlchemy sync pool size per Celery worker process
KB_VECTOR_INSERT_BATCH_SIZE=500              # rows per INSERT batch in the vector write path

# --- Parser routing ---
# OCR_PROVIDER=none → NullOCRProvider; complex/scanned PDFs fall back to the
# local text parser and fail clearly if no text is extracted. OCR_PROVIDER=vlm
# enables LiteLLM-routed vision OCR for high-complexity scanned PDFs.
OCR_PROVIDER=none                            # none | vlm
VLM_OCR_DPI=150                              # PDF render resolution before sending page images to the VLM
VLM_OCR_DETAIL=high                          # auto | low | high; passed as OpenAI-compatible image detail
VLM_OCR_MAX_PAGES=50                         # page cap for OCR cost/runtime guardrails
VLM_OCR_REQUEST_TIMEOUT_SECONDS=120.0        # per-page VLM OCR timeout
DOC_PARSER_POLICY=complexity                 # complexity | always_docling | always_basic
ENABLE_DOCLING_ROUTING=true                  # route complex PDFs/DOCX/PPTX to Docling

# OCR / complexity thresholds
PARSE_OCR_CHARS_THRESHOLD=100
PARSE_OCR_IMAGE_RATIO_THRESHOLD=0.95
PARSE_OCR_EMPTY_PAGE_RATIO_THRESHOLD=0.5
PARSE_OCR_IMAGE_PAGE_RATIO_THRESHOLD=0.3

# PDF complexity thresholds
PDF_VERY_COMPLEX_EMPTY_PAGE_RATIO_THRESHOLD=0.8
PDF_VERY_COMPLEX_IMAGE_PAGE_RATIO_THRESHOLD=0.75
PDF_VERY_COMPLEX_PAGE_COUNT_THRESHOLD=250

# DOCX complexity thresholds
DOCX_COMPLEX_TABLE_COUNT_THRESHOLD=1
DOCX_COMPLEX_INLINE_SHAPE_THRESHOLD=1
DOCX_COMPLEX_MAX_PARAGRAPH_CHARS_THRESHOLD=300

# PPTX complexity thresholds
PPTX_COMPLEX_TABLE_COUNT_THRESHOLD=1
PPTX_COMPLEX_PICTURE_COUNT_THRESHOLD=3
PPTX_COMPLEX_CHART_COUNT_THRESHOLD=1
PPTX_COMPLEX_SHAPE_COUNT_THRESHOLD=30

# --- Docling (primary parser for complex documents) ---
DOCLING_ENABLED=true
DOCLING_DO_OCR=true
DOCLING_DO_TABLE_STRUCTURE=true
DOCLING_TABLE_MODE=accurate                  # accurate | fast
DOCLING_TIMEOUT_SECONDS=120.0
DOCLING_MAX_PAGES=500
DOCLING_MAX_FILE_SIZE_MB=200
DOCLING_IMAGES_SCALE=1.5
DOCLING_TUNING_PROFILE=balanced              # balanced | speed | quality
DOCLING_OCR_LANG=en
DOCLING_DISABLE_OCR_FOR_LOW_COMPLEXITY=false
DOCLING_DISABLE_TABLES_FOR_LOW_COMPLEXITY=false
DOCLING_ENABLE_ACCELERATION=true
DOCLING_ACCELERATOR_DEVICE=auto              # auto | cpu | cuda | mps
DOCLING_ACCELERATOR_THREADS=4
